# Keep host build artifacts and secrets out of the Docker build context.
# Both Dockerfiles run `COPY packages/<pkg> ...` — without this file the COPY
# ships host node_modules, .next output, and local databases into the image.

# Dependencies (installed inside the build)
node_modules
**/node_modules

# Build outputs
**/dist
**/.next
**/.mastra
**/.turbo
**/coverage
**/.venv
**/__pycache__

# VCS / tooling state
.git
.github
.brv
**/.brv
.firecrawl
.claude

# Local data and databases
data
packages/crawler/data
!packages/pipeline/data
packages/pipeline/data/*
# Versioned evaluation inputs and CFR supersession rules ship with the image.
!packages/pipeline/data/golden
!packages/pipeline/data/golden/**
!packages/pipeline/data/jev
!packages/pipeline/data/jev/*.json
packages/pipeline/data/jev/campaigns/
!packages/pipeline/data/references
!packages/pipeline/data/references/**
*.db
*.db-shm
*.db-wal
*.duckdb
*.duckdb.wal

# Secrets
.env
.env.*
!.env.example

# Not needed in images
e2e
docs
