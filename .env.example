## LLM API keys (used by packages/agent)
# OPENAI_API_KEY is always required: the default agent model (gpt-5.4), the
# hallucination verifier, the prompt-injection detector, and observational
# memory all run on OpenAI.
OPENAI_API_KEY=
# EVAL_OPENAI_API_KEY is optional. When set, `pipeline eval --level answer`
# runs the agent on THIS key instead of OPENAI_API_KEY, so a research run can't
# drain the production agent's OpenAI quota (which would surface to users as
# failing chats). Use a separate OpenAI project/account with its own budget.
EVAL_OPENAI_API_KEY=
# ANTHROPIC_API_KEY is optional — only needed when AGENT_MODEL is a claude-* model.
ANTHROPIC_API_KEY=
# GROQ_API_KEY is optional — only needed when POLICY_CORPUS_RERANK_MODEL uses a
# groq/ prefix (fast open-weight inference for the latency-bound reranker),
# e.g. POLICY_CORPUS_RERANK_MODEL=groq/openai/gpt-oss-20b
GROQ_API_KEY=
VOYAGE_API_KEY=

## Agent model selection (see RUNBOOK.md). Default: gpt-5.4.
# AGENT_MODEL=gpt-5.4
# AGENT_MODEL=claude-sonnet-4-6  # requires ANTHROPIC_API_KEY

## Neo4j (defaults match docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medicaid-dev

## Mastra storage (LibSQL/DuckDB)
DATABASE_URL=file:./mastra.db
# MASTRA_OBSERVABILITY_PATH=:memory:  # recommended for eval CLI runs to avoid DuckDB lock contention

## Mastra server
PORT=4111

## WorkOS auth (used by packages/agent server + packages/web)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

## E2E test user (created in WorkOS dashboard)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

## Sentry error tracking (optional — unset = fully disabled, no-op)
# NOTE: Sentry init is also skipped whenever the environment resolves to
# "development" (SENTRY_ENVIRONMENT / NEXT_PUBLIC_SENTRY_ENVIRONMENT, falling
# back to NODE_ENV), so a DSN set here does NOT send local `next dev` / `mastra
# dev` errors into the shared Sentry project. Deploys (prod/staging) report.
# Runtime DSN for both services' server-side error capture. Leave empty to
# disable. In production set per-service via Railway.
SENTRY_DSN=
# Browser DSN for packages/web. NEXT_PUBLIC_* is inlined by Next.js at BUILD
# time, so on Railway it must be a build-time variable on the web service.
NEXT_PUBLIC_SENTRY_DSN=
# Environment label (e.g. production, staging). Defaults to NODE_ENV if unset.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Performance tracing sample rate (0–1). Default 0 = errors only. Raise to
# enable tracing later with no code change.
# SENTRY_TRACES_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Source-map upload (packages/web build only). Without SENTRY_AUTH_TOKEN, upload
# is skipped and the build still succeeds. Set these as BUILD-time variables on
# the Railway web service. SENTRY_RELEASE is derived from RAILWAY_GIT_COMMIT_SHA
# in the Dockerfiles.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
