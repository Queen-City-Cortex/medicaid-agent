## LLM API keys (used by packages/agent)
# OPENAI_API_KEY is always required: the default agent model (gpt-5.6-terra), the
# hallucination verifier, the scope gate and the prompt-injection detector all
# run on OpenAI (as does observational memory when it is turned on).
OPENAI_API_KEY=
# EVAL_OPENAI_API_KEY is optional. When set, `pipeline eval --level answer`
# runs the agent on THIS key instead of OPENAI_API_KEY, so a research run can't
# drain the production agent's OpenAI quota (which would surface to users as
# failing chats). Use a separate OpenAI project/account with its own budget.
EVAL_OPENAI_API_KEY=
# ANTHROPIC_API_KEY is optional — only needed when AGENT_MODEL is a claude-* model.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

## Agent model selection (see RUNBOOK.md). Default: gpt-5.6-terra.
# AGENT_MODEL=gpt-5.6-terra
# AGENT_MODEL=claude-sonnet-4-6  # requires ANTHROPIC_API_KEY
# Reasoning effort for the chat and deep-research agents on OpenAI models, set
# explicitly so it does not change with the model's API default. One of none,
# minimal, low, medium, high, xhigh; any other value stops startup. A model must
# support the value chosen. Evaluation results record the value the agent used.
# AGENT_REASONING_EFFORT=medium

## Answer verification. Production always requires verification.
# VERIFIER_MODEL=gpt-5.6-terra
# Checks use low reasoning effort, a 30-second deadline, and at most two passes.
# VERIFIER_ENABLED=false is permitted only for local CLI debugging.

## Abuse protections (see RUNBOOK.md). All optional — defaults shown.
# Pre-LLM off-topic gate: one classifier call blocks clearly-off-topic chat
# before the main model runs. On unless exactly 'false'. Fails open on errors.
# SCOPE_GATE_ENABLED=true
# SCOPE_GATE_MODEL sets the classifier model for the scope gate, both
# prompt-injection detectors and the default health-probe target. The default
# (CLASSIFIER_MODEL in packages/agent/src/model.ts) is gpt-5-mini, which leaves
# the OpenAI API on 2026-12-11; see docs/development/gotchas.md.
# SCOPE_GATE_MODEL=gpt-5-mini
# Observational memory (a model-written summary of earlier turns) is off unless
# this is 'true' or '1'. Thread history does not depend on it.
# OBSERVATIONAL_MEMORY_ENABLED=false
# Per-user sliding-window limits on agent-run starts (chat + deep research).
# A value <= 0 disables that window.
# RATE_LIMIT_MESSAGES_PER_HOUR=30
# RATE_LIMIT_MESSAGES_PER_DAY=150
# Server-side input caps: chars in the latest user message (mirrors the
# browser's textarea maxLength) and bytes per request body (the body carries
# the whole thread history, so this is a request cap, not a message cap).
# MAX_MESSAGE_CHARS=10000
# MAX_BODY_BYTES=2097152

## Neo4j (defaults match docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medicaid-dev

## Mastra storage (LibSQL/DuckDB)
DATABASE_URL=file:./mastra.db
# MASTRA_OBSERVABILITY_PATH=:memory:  # recommended for eval CLI runs to avoid DuckDB lock contention

## Mastra server
PORT=4111

## WorkOS auth (used by packages/agent server + packages/web)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

## E2E test user (created in WorkOS dashboard)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

## Sentry error tracking (optional — unset = fully disabled, no-op)
# NOTE: Sentry init is also skipped whenever the environment resolves to
# "development" (SENTRY_ENVIRONMENT / NEXT_PUBLIC_SENTRY_ENVIRONMENT, falling
# back to NODE_ENV), so a DSN set here does NOT send local `next dev` / `mastra
# dev` errors into the shared Sentry project. Deploys (prod/staging) report.
# Runtime DSN for both services' server-side error capture. Leave empty to
# disable. In production set per-service via Railway.
SENTRY_DSN=
# Browser DSN for packages/web. NEXT_PUBLIC_* is inlined by Next.js at BUILD
# time, so on Railway it must be a build-time variable on the web service.
NEXT_PUBLIC_SENTRY_DSN=
# Environment label (e.g. production, staging). REQUIRED for server-side Sentry
# to initialize — a local run without it no-ops instead of leaking into the
# shared project (deploys set it via Railway). 'development' is also suppressed.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Performance tracing sample rate (0–1). Defaults to 0.1 (10%) in code so
# production errors carry transaction/span context. Set to 0 to disable, or
# raise for more coverage. NEXT_PUBLIC_* is inlined at build time (web service).
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Source-map upload (packages/web build only). Without SENTRY_AUTH_TOKEN, upload
# is skipped and the build still succeeds. Set these as BUILD-time variables on
# the Railway web service. SENTRY_RELEASE is derived from RAILWAY_GIT_COMMIT_SHA
# in the Dockerfiles.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Opt-in Jev experiments (pinned jev-1.13.0); defaults preserve current behavior.
# See docs/development/jev.md for review, evaluation and budget gates.
TYPESAFE_API_KEY=
SCOPE_GATE_PROVIDER=openai
JEV_SECTION_ROLES_ENABLED=false
# Comma-separated roles from the reviewed qualification report; empty = observational.
JEV_SECTION_ROLE_ALLOWLIST=
