# graphify scope control — keep the knowledge graph to source + docs only.
#
# This repo's graphify graph is a *codebase architecture* map (god nodes,
# code communities). The directories below are generated/crawled DATA the app
# processes, not code — ingesting them would add hundreds of millions of words
# of PDFs/JSON and balloon every `--update`. They are deliberately excluded.

# Crawled source documents and Docling pipeline output (mostly untracked, regenerated)
packages/*/data/

# Mastra compiled build bundles — generated output, not source (was ~57% of the graph)
.mastra/
**/.mastra/

# Caches and tool output
graphify-out/
.brv/
**/.brv/

# Browser-automation / test scratch and generated reports (screenshots, HTML reports)
.playwright-mcp/
e2e/playwright-report/

# Playwright auth state — WorkOS session cookie. SECRET: never ingest into the graph.
e2e/playwright/.auth/
**/.auth/

# Generated design-review screenshots (gitignored; vision-token noise, no arch value)
e2e/design-shots/

# Next.js generated boilerplate assets / types (no architectural value)
packages/web/public/*.svg
**/next-env.d.ts
