--- a/packages/policy-corpus/src/internal/policy-number.ts	1969-12-31 19:00:00
+++ b/packages/policy-corpus/src/internal/policy-number.ts	2026-10-05 05:24:07
@@ -0,0 +1,120 @@
+// Policy-number identity: one comparison key and one extraction rule, shared
+// by query analysis, lookupPolicy, policy-scoped retrieval and reranking.
+
+/**
+ * Comparison key for a policy number: upper-case with whitespace and hyphens
+ * removed, so "1-H", "1H" and "1h" name one policy and "MA 2180" equals
+ * "MA-2180". Use it only to compare; show the stored number to people.
+ */
+export function policyNumberKey(value: string | null | undefined): string {
+  return (value ?? '').toUpperCase().replace(/[\s-]/g, '');
+}
+
+/** Cypher twin of `policyNumberKey` for a string expression. */
+export function policyNumberKeyCypher(expression: string): string {
+  return `replace(replace(toUpper(${expression}), '-', ''), ' ', '')`;
+}
+
+/**
+ * "3D", "1-H", "9" and "15" are policy numbers, and also ordinary clinical and
+ * everyday tokens ("3D mammogram", "stage 3b", "age 9"). A number of this
+ * shape counts as a policy reference only where the question marks it as one.
+ */
+export function isAmbiguousPolicyToken(policyNumber: string | null | undefined): boolean {
+  return /^\d{1,2}(?:-?[A-Za-z])?$/.test((policyNumber ?? '').trim());
+}
+
+/** De-duplicates policy numbers by `policyNumberKey`, keeping the first spelling. */
+export function dedupePolicyNumbers(policyNumbers: string[]): string[] {
+  const seen = new Set<string>();
+  return policyNumbers.filter((policyNumber) => {
+    const key = policyNumberKey(policyNumber);
+    if (!key || seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+}
+
+const TOKEN_START = String.raw`(?<![\w-])`;
+const TOKEN_END = String.raw`(?![\w-])`;
+// 3L, 1-H, 8A-1, 1-O-1
+const CLINICAL = String.raw`\d{1,2}-?[A-Za-z](?:-\d{1,2})*`;
+// 8A-1, 1A-27, 1-O-1: a numeric suffix is distinctive enough to need no cue.
+const CLINICAL_SUFFIXED = String.raw`\d{1,2}-?[A-Za-z](?:-\d{1,2})+`;
+const CLINICAL_BARE = String.raw`\d{1,2}-?[A-Za-z]`;
+const CUE = String.raw`\b(?:polic(?:y|ies)|ccps?)(?:\s+(?:no\.?|numbers?))?\s*[(:#]?\s*`;
+// "policy 30 days", "policy 15 visit limit": a quantity, not policy 30 or 15.
+const NOT_A_QUANTITY = String.raw`(?!\s*(?:%|percent\b|(?:-\s*)?(?:day|week|month|year|hour|minute|visit|unit|time|dollar)s?\b))`;
+
+const SUFFIXED_RE = new RegExp(`${TOKEN_START}${CLINICAL_SUFFIXED}${TOKEN_END}`, 'gi');
+// Mirrors the loader, which stores PREFIX-NNNN and drops any form suffix
+// ("DHB-5125B", "MA-3233-A" and "MA-3321-1.pdf" are stored under the base).
+const MANUAL_RE = /(?<![\w-])(MA|DMA|DHB|DSS)[- ]?(\d{4})(?!\d)/gi;
+const CUED_RE = new RegExp(`${CUE}(${CLINICAL}|\\d{1,2})${TOKEN_END}${NOT_A_QUANTITY}`, 'gi');
+const UNDER_RE = new RegExp(String.raw`\bunder\s+(${CLINICAL})${TOKEN_END}`, 'gi');
+const TRAILING_CUE_RE = new RegExp(String.raw`${TOKEN_START}(${CLINICAL})\s+(?:polic(?:y|ies)|ccps?)\b`, 'gi');
+const BARE_RE = new RegExp(`${TOKEN_START}${CLINICAL_BARE}${TOKEN_END}`, 'gi');
+const JOIN_RE = /^\s*(?:,|\/|&|\band\b|\bor\b|\bvs\.?|\bversus\b)\s*$/i;
+
+interface Span {
+  start: number;
+  end: number;
+  text: string;
+}
+
+/**
+ * Policy numbers the question names.
+ *
+ * - Clinical numbers with a numeric suffix (8A-1, 1A-27, 1-O-1) and manual
+ *   numbers (MA-2180, "MA 2180", DHB-5125B) are taken wherever they appear.
+ * - A bare clinical token (3L, 1-H) or numeral (7, 9, 15) is taken only next
+ *   to a cue: "policy 3L", "CCP 9", "Clinical Coverage Policy No. 1-H",
+ *   "policy (5B)", "under 10A", "the 3L policy", or joined to a number that
+ *   already qualified ("3L or 3L-1", "policies 8C and 8A").
+ *
+ * The result is de-duplicated by `policyNumberKey`, so "1-H" and "1H" count
+ * once. Compare the result with stored numbers through `policyNumberKey`.
+ */
+export function extractExplicitPolicyNumbers(query: string): string[] {
+  const spans: Span[] = [];
+  for (const match of query.matchAll(SUFFIXED_RE)) {
+    spans.push({ start: match.index, end: match.index + match[0].length, text: match[0] });
+  }
+  for (const match of query.matchAll(MANUAL_RE)) {
+    spans.push({ start: match.index, end: match.index + match[0].length, text: `${match[1]}-${match[2]}` });
+  }
+  for (const re of [CUED_RE, UNDER_RE]) {
+    for (const match of query.matchAll(re)) {
+      const end = match.index + match[0].length;
+      spans.push({ start: end - match[1].length, end, text: match[1] });
+    }
+  }
+  for (const match of query.matchAll(TRAILING_CUE_RE)) {
+    spans.push({ start: match.index, end: match.index + match[1].length, text: match[1] });
+  }
+
+  // "3L or 3L-1", "policies 8C and 8A": a bare token joined to a qualified
+  // number qualifies too. Repeat so a list of three resolves.
+  let grew = true;
+  while (grew) {
+    grew = false;
+    for (const match of query.matchAll(BARE_RE)) {
+      const start = match.index;
+      const end = start + match[0].length;
+      if (spans.some((span) => span.start <= start && span.end >= end)) continue;
+      const joined = spans.some(
+        (span) =>
+          (span.start >= end && JOIN_RE.test(query.slice(end, span.start))) ||
+          (span.end <= start && JOIN_RE.test(query.slice(span.end, start))),
+      );
+      if (joined) {
+        spans.push({ start, end, text: match[0] });
+        grew = true;
+      }
+    }
+  }
+
+  return dedupePolicyNumbers(
+    spans.sort((left, right) => left.start - right.start).map((span) => span.text.toUpperCase()),
+  );
+}
