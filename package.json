{
  "name": "nc-medicaid-navigator",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "22.23.3",
    "npm": "11.11.0"
  },
  "overrides": {
    "ajv": {
      "fast-uri": "4.2.1"
    },
    "cheerio": {
      "undici": "7.30.0"
    },
    "@mastra/core": "1.58.0",
    "postcss": "8.5.28",
    "express": {
      "qs": "6.16.0"
    }
  },
  "dependencies": {
    "fast-uri": "4.2.1",
    "undici": "7.30.0",
    "ws": "8.22.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:ops": "node --test scripts/ops/tests/*.test.mjs && bash scripts/ops/tests/railway-corpus-job.sh",
    "test:integration": "npm run test:integration -w @nc-medicaid/agent",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck:tests": "turbo run typecheck:tests",
    "audit:production": "node scripts/check-production-audit.mjs",
    "test:e2e": "cd e2e && HERMETIC_AUTH=1 npx playwright test --project=mocked",
    "test:e2e:smoke": "cd e2e && npx playwright test --project=smoke",
    "smoke:prod": "cd e2e && node scripts/smoke-production.mjs",
    "test:e2e:all": "cd e2e && npx playwright test",
    "test:e2e:ui": "cd e2e && HERMETIC_AUTH=1 npx playwright test --project=mocked --ui",
    "deploy-data": "bash scripts/deploy-data.sh",
    "dev": "docker volume create neo4j-medicaid-data >/dev/null && docker compose up -d --wait neo4j && npm run dev -w @nc-medicaid/web & npm run dev -w @nc-medicaid/agent & wait",
    "dev:infra": "docker volume create neo4j-medicaid-data >/dev/null && docker compose up -d",
    "dev:stop": "docker compose down",
    "dev:web": "npm run dev -w @nc-medicaid/web",
    "dev:agent": "npm run dev -w @nc-medicaid/agent"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "tsx": "^4.23.15"
  }
}
