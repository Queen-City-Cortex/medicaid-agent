{
  "name": "@nc-medicaid/agent",
  "version": "1.0.0",
  "description": "NC Medicaid Navigator agent powered by Mastra",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "mastra dev --dir src",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cli": "tsx src/index.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/openai": "^3.0.49",
    "@mastra/ai-sdk": "^1.2.1",
    "@mastra/core": "^1.17.0",
    "@mastra/libsql": "^1.7.2",
    "@mastra/memory": "^1.10.0",
    "neo4j-driver": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
