{
  "name": "@nc-medicaid/agent",
  "version": "1.0.0",
  "description": "NC Medicaid Navigator agent powered by Mastra",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "mastra dev --dir src",
    "build": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:integration": "RUN_NEO4J_INTEGRATION=1 vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "cli": "tsx src/index.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/openai": "^3.0.49",
    "@libsql/client": "^0.15.15",
    "@mastra/ai-sdk": "^1.2.1",
    "@mastra/auth-workos": "^1.1.2",
    "@mastra/core": "^1.17.0",
    "@mastra/duckdb": "^1.1.1",
    "@mastra/libsql": "^1.7.2",
    "@mastra/loggers": "^1.1.0",
    "@mastra/memory": "^1.10.0",
    "@mastra/observability": "^1.7.1",
    "@nc-medicaid/policy-corpus": "*",
    "@sentry/node": "^10.59.0",
    "ai": "^6.0.141",
    "exa-js": "^2.14.0",
    "neo4j-driver": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "hono": "^4.12.9",
    "mastra": "^1.3.18",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
