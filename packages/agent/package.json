{
  "name": "@nc-medicaid/agent",
  "version": "1.0.0",
  "description": "NC Medicaid Navigator agent powered by Mastra",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "mastra dev --dir src",
    "build": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:integration": "RUN_NEO4J_INTEGRATION=1 vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.134",
    "@ai-sdk/openai": "^3.0.130",
    "@libsql/client": "^0.18.0",
    "@mastra/ai-sdk": "1.11.1",
    "@mastra/auth-workos": "1.6.6",
    "@mastra/core": "1.79.0",
    "@mastra/duckdb": "1.14.1",
    "@mastra/libsql": "1.26.2",
    "@mastra/loggers": "1.3.8",
    "@mastra/memory": "1.38.0",
    "@mastra/observability": "1.20.1",
    "@nc-medicaid/contracts": "*",
    "@nc-medicaid/policy-corpus": "*",
    "@sentry/node": "^10.75.3",
    "ai": "^6.0.311",
    "exa-js": "^2.26.0",
    "neo4j-driver": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mastra/deployer": "1.79.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.5",
    "hono": "^4.12.27",
    "mastra": "1.35.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "4.1.12"
  }
}
