{
  "name": "@nc-medicaid/crawler",
  "version": "1.0.0",
  "description": "Polite incremental crawler for NC Medicaid policy documents",
  "type": "module",
  "scripts": {
    "crawl": "tsx src/index.ts crawl",
    "check": "tsx src/index.ts check",
    "stats": "tsx src/index.ts stats",
    "build": "tsc",
    "lint": "eslint .",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.0.0",
    "commander": "^15.0.0",
    "file-type": "^22.0.1",
    "p-queue": "^9.3.0",
    "robots-parser": "^3.0.0",
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@vitest/coverage-v8": "^4.1.9",
    "domhandler": "^6.0.1",
    "eslint": "^9.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
