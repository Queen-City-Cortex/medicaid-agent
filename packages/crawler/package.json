{
  "name": "@nc-medicaid/crawler",
  "version": "1.0.0",
  "description": "Polite incremental crawler for NC Medicaid policy documents",
  "type": "module",
  "scripts": {
    "crawl": "tsx src/index.ts crawl",
    "check": "tsx src/index.ts check",
    "stats": "tsx src/index.ts stats",
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql",
    "lint": "eslint .",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.0.0",
    "commander": "^15.0.0",
    "file-type": "^22.2.0",
    "p-queue": "^10.0.0",
    "robots-parser": "^3.0.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.0",
    "@vitest/coverage-v8": "4.1.12",
    "domhandler": "^6.0.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "4.1.12",
    "@types/node": "^22.20.5"
  }
}
