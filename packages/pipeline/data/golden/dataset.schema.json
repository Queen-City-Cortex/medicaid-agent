{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "version",
      "created",
      "updated",
      "question",
      "difficulty",
      "reasoning_type",
      "topics",
      "answer",
      "evidence",
      "source"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(q|h)-\\d+$"
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "created": {
        "type": "string",
        "format": "date"
      },
      "updated": {
        "type": "string",
        "format": "date"
      },
      "question": {
        "type": "string",
        "minLength": 10
      },
      "difficulty": {
        "type": "string",
        "enum": [
          "simple",
          "moderate",
          "complex"
        ]
      },
      "reasoning_type": {
        "type": "string",
        "enum": [
          "single_lookup",
          "multi_hop",
          "cross_document",
          "temporal",
          "negative_answer",
          "federal_reference"
        ]
      },
      "topics": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "target_users": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "answer": {
        "type": "object",
        "required": [
          "text",
          "confidence"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "evidence": {
        "type": "object",
        "required": [
          "primary_sections"
        ],
        "properties": {
          "primary_sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "document_id",
                "section_id",
                "relevance"
              ],
              "properties": {
                "document_id": {
                  "type": "string"
                },
                "section_id": {
                  "type": "string"
                },
                "section_number": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "relevance": {
                  "type": "string"
                }
              }
            },
            "minItems": 1
          },
          "supporting_sections": {
            "type": "array"
          },
          "cross_references": {
            "type": "array"
          },
          "federal_references": {
            "type": "array"
          }
        }
      },
      "source": {
        "type": "string",
        "enum": [
          "lived_experience",
          "legal_aid",
          "edge_case",
          "regression",
          "held_out_paraphrase"
        ]
      },
      "notes": {
        "type": "string"
      },
      "paraphrase_of": {
        "type": "string",
        "pattern": "^q-\\d+$"
      }
    }
  }
}
