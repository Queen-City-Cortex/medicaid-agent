{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "version",
      "created",
      "updated",
      "question",
      "difficulty",
      "reasoning_type",
      "topics",
      "answer",
      "evidence",
      "source",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(q|h)-\\d+$"
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "created": {
        "type": "string",
        "format": "date"
      },
      "updated": {
        "type": "string",
        "format": "date"
      },
      "question": {
        "type": "string",
        "minLength": 10
      },
      "difficulty": {
        "type": "string",
        "enum": [
          "simple",
          "moderate",
          "complex"
        ]
      },
      "reasoning_type": {
        "type": "string",
        "enum": [
          "single_lookup",
          "multi_hop",
          "cross_document",
          "temporal",
          "negative_answer",
          "federal_reference"
        ]
      },
      "topics": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "target_users": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "answer": {
        "type": "object",
        "required": [
          "confidence"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "evidence": {
        "type": "object",
        "required": [
          "primary_sections"
        ],
        "properties": {
          "primary_sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "document_id",
                "section_id",
                "relevance"
              ],
              "properties": {
                "document_id": {
                  "type": "string"
                },
                "section_id": {
                  "type": "string"
                },
                "section_number": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "relevance": {
                  "type": "string"
                }
              }
            },
            "minItems": 1
          },
          "supporting_sections": {
            "type": "array"
          },
          "cross_references": {
            "type": "array"
          },
          "federal_references": {
            "type": "array"
          }
        }
      },
      "source": {
        "type": "string",
        "enum": [
          "lived_experience",
          "legal_aid",
          "edge_case",
          "regression",
          "held_out_paraphrase"
        ]
      },
      "notes": {
        "type": "string"
      },
      "paraphrase_of": {
        "type": "string",
        "pattern": "^q-\\d+$"
      },
      "status": {
        "type": "string",
        "enum": [
          "validated",
          "needs_validation"
        ],
        "description": "validated: every fact the answer asserts is backed by a verbatim supporting quote from a section the entry cites. needs_validation: skipped by evaluations until reviewed."
      },
      "supporting_quotes": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "section_id",
            "quote"
          ],
          "additionalProperties": false,
          "properties": {
            "section_id": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      },
      "validation_note": {
        "type": "string",
        "minLength": 10,
        "description": "For needs_validation entries: what the cited sections do not support."
      },
      "expected_behavior": {
        "type": "string",
        "minLength": 10,
        "description": "What the agent is expected to do (tools to call, what not to claim). Never sent to the judge as the reference answer."
      }
    }
  }
}
