{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/web/Dockerfile",
    "watchPatterns": [
      "/package.json",
      "/package-lock.json",
      "/packages/web/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "sleepApplication": true,
    "limitOverride": {
      "containers": {
        "memoryBytes": 1073741824
      }
    }
  }
}
