<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ncmedicaid.daily-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/scripts/ops/daily-check.sh</string>
  </array>
  <!-- 07:30 daily. launchd coalesces intervals missed during sleep into one
       run at wake (cron would silently skip them). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
  <!-- launchd does not load the user's fish config: node/npx/jq/rclone need
       Homebrew on PATH explicitly. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/nc-medicaid/launchd-daily-check.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/nc-medicaid/launchd-daily-check.log</string>
</dict>
</plist>
